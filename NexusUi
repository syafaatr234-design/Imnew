local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local Library = {}

local function Create(class, props)
    local inst = Instance.new(class)
    for i, v in pairs(props) do inst[i] = v end
    return inst
end

function Library:Create(info)
    local Main = { Tabs = {} }
    
    local ScreenGui = Create("ScreenGui", {
        Name = "ModernLib",
        Parent = CoreGui,
        IgnoreGuiInset = true,
        DisplayOrder = 100
    })

    local LoaderObj = {}
    local LoaderFrame = Create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.fromRGB(10, 10, 10),
        Parent = ScreenGui,
        ZIndex = 100,
        Visible = info.Loader or false
    })

    local LeftPanel = Create("Frame", {
        Size = UDim2.fromScale(0.5, 1),
        BackgroundColor3 = Color3.fromRGB(15, 15, 15),
        BorderSizePixel = 0,
        Parent = LoaderFrame
    })

    local RightPanel = Create("Frame", {
        Size = UDim2.fromScale(0.5, 1),
        Position = UDim2.fromScale(0.5, 0),
        BackgroundColor3 = Color3.fromRGB(15, 15, 15),
        BorderSizePixel = 0,
        Parent = LoaderFrame
    })

    local LoadLabel = Create("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "Initialising...",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamMedium,
        TextSize = 20,
        Parent = LoaderFrame,
        ZIndex = 105
    })

    function LoaderObj:Start()
        LoaderFrame.Visible = true
    end

    function LoaderObj:SetText(val)
        LoadLabel.Text = tostring(val)
    end

    function LoaderObj:End()
        local tInfo = TweenInfo.new(1, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
        TweenService:Create(LoadLabel, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
        task.wait(0.4)
        TweenService:Create(LeftPanel, tInfo, {Position = UDim2.fromScale(-0.5, 0)}):Play()
        TweenService:Create(RightPanel, tInfo, {Position = UDim2.fromScale(1, 0)}):Play()
        TweenService:Create(LoaderFrame, tInfo, {BackgroundTransparency = 1}):Play()
        task.delay(1, function() LoaderFrame:Destroy() end)
    end

    local Window = Create("Frame", {
        Name = "Main",
        Size = UDim2.fromOffset(500, 350),
        Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(25, 25, 25),
        Parent = ScreenGui,
        ClipsDescendants = true
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = Window})

    local TabContainer = Create("Frame", {
        Name = "TabContent",
        Size = UDim2.new(1, -20, 1, -60),
        Position = UDim2.fromOffset(10, 50),
        BackgroundTransparency = 1,
        Parent = Window
    })

    -- Dragging Logic
    local dragStart, startPos, dragging
    Window.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Window.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    function Main:Tab(name)
        local TabPage = Create("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Visible = (#TabContainer:GetChildren() == 0),
            ScrollBarThickness = 0,
            CanvasSize = UDim2.fromScale(0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Parent = TabContainer
        })
        Create("UIListLayout", {Padding = UDim.new(0, 10), Parent = TabPage})

        local TabActions = {}
        function TabActions:Section(title)
            local Sec = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 25),
                BackgroundTransparency = 1,
                Parent = TabPage
            })
            Create("TextLabel", {
                Text = title:upper(),
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                TextColor3 = Color3.fromRGB(120, 120, 120),
                Size = UDim2.new(1, 0, 0, 15),
                TextXAlignment = "Left",
                BackgroundTransparency = 1,
                Parent = Sec
            })
            Create("Frame", {
                Size = UDim2.new(1, 0, 0, 1),
                Position = UDim2.fromOffset(0, 18),
                BackgroundColor3 = Color3.fromRGB(45, 45, 45),
                BorderSizePixel = 0,
                Parent = Sec
            })

            local SecActions = {}
            function SecActions:Button(txt, callback)
                local B = Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 35),
                    BackgroundColor3 = Color3.fromRGB(35, 35, 35),
                    Text = "  " .. txt,
                    TextColor3 = Color3.fromRGB(200, 200, 200),
                    Font = Enum.Font.Gotham,
                    TextXAlignment = "Left",
                    Parent = TabPage
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = B})
                B.MouseButton1Click:Connect(callback)
            end
            return SecActions
        end
        return TabActions
    end

    return Main, LoaderObj
end

return Library
