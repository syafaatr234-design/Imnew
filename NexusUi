top.BackgroundColor3=Color3.fromRGB(18,18,24)
top.Parent=main

local title=Instance.new("TextLabel")
title.Text=cfg.Title or "Window"
title.Font=Enum.Font.GothamBold
title.TextColor3=Color3.new(1,1,1)
title.BackgroundTransparency=1
title.Size=UDim2.new(1,-100,1,0)
title.Position=UDim2.fromOffset(10,0)
title.TextXAlignment=Enum.TextXAlignment.Left
title.Parent=top

local close=Instance.new("TextButton")
close.Size=UDim2.fromOffset(30,30)
close.Position=UDim2.new(1,-35,0,5)
close.Text="X"
close.BackgroundColor3=Color3.fromRGB(40,40,48)
close.TextColor3=Color3.new(1,1,1)
close.Parent=top

local minimize=Instance.new("TextButton")
minimize.Size=UDim2.fromOffset(30,30)
minimize.Position=UDim2.new(1,-70,0,5)
minimize.Text="-"
minimize.BackgroundColor3=Color3.fromRGB(40,40,48)
minimize.TextColor3=Color3.new(1,1,1)
minimize.Parent=top

local tabHolder=Instance.new("Frame")
tabHolder.Size=UDim2.new(0,120,1,-40)
tabHolder.Position=UDim2.fromOffset(0,40)
tabHolder.BackgroundColor3=Color3.fromRGB(20,20,26)
tabHolder.Parent=main

local pageHolder=Instance.new("Frame")
pageHolder.Size=UDim2.new(1,-120,1,-40)
pageHolder.Position=UDim2.fromOffset(120,40)
pageHolder.BackgroundTransparency=1
pageHolder.Parent=main

close.MouseButton1Click:Connect(function()
main:Destroy()
end)

minimize.MouseButton1Click:Connect(function()
if pageHolder.Visible then
pageHolder.Visible=false
main.Size=UDim2.fromOffset(600,40)
else
pageHolder.Visible=true
main.Size=UDim2.fromOffset(600,420)
end
end)

local window={}
window.Tabs={}

function window:Tab(name)
local button=Instance.new("TextButton")
button.Size=UDim2.new(1,0,0,40)
button.Text=name
button.BackgroundColor3=Color3.fromRGB(30,30,36)
button.TextColor3=Color3.new(1,1,1)
button.Parent=tabHolder

local page=Instance.new("ScrollingFrame")
page.Size=UDim2.fromScale(1,1)
page.CanvasSize=UDim2.new(0,0,0,0)
page.ScrollBarThickness=4
page.Visible=false
page.BackgroundTransparency=1
page.Parent=pageHolder

local layout=Instance.new("UIListLayout")
layout.Padding=UDim.new(0,10)
layout.Parent=page

button.MouseButton1Click:Connect(function()
for _,v in pairs(pageHolder:GetChildren())do
if v:IsA("ScrollingFrame") then
v.Visible=false
end
end
page.Visible=true
end)

local tab={}
function tab:Section(title)
local holder=Instance.new("Frame")
holder.Size=UDim2.new(1,-10,0,30)
holder.BackgroundTransparency=1
holder.Parent=page

local text=Instance.new("TextLabel")
text.Text=title
text.Font=Enum.Font.GothamBold
text.TextColor3=Color3.new(1,1,1)
text.BackgroundTransparency=1
text.Size=UDim2.new(1,0,0,20)
text.TextXAlignment=Enum.TextXAlignment.Left
text.Parent=holder

local line=Instance.new("Frame")
line.Size=UDim2.new(1,0,0,2)
line.Position=UDim2.fromOffset(0,22)
line.BackgroundColor3=Color3.fromRGB(50,50,60)
line.Parent=holder

local content=Instance.new("Frame")
content.Size=UDim2.new(1,0,0,0)
content.BackgroundTransparency=1
content.Parent=holder

local cl=Instance.new("UIListLayout")
cl.Padding=UDim.new(0,6)
cl.Parent=content

local sec={}

function sec:Button(name,cb)
local b=Instance.new("TextButton")
b.Size=UDim2.new(1,0,0,30)
b.Text=name
b.BackgroundColor3=Color3.fromRGB(40,40,48)
b.TextColor3=Color3.new(1,1,1)
b.Parent=content
b.MouseButton1Click:Connect(function()
pcall(cb)
end)
end

function sec:Toggle(name,default,cb)
local val=default
local b=Instance.new("TextButton")
b.Size=UDim2.new(1,0,0,30)
b.Text=name.." : "..tostring(val)
b.BackgroundColor3=Color3.fromRGB(40,40,48)
b.TextColor3=Color3.new(1,1,1)
b.Parent=content
b.MouseButton1Click:Connect(function()
val=not val
b.Text=name.." : "..tostring(val)
pcall(cb,val)
end)
end

function sec:Input(name,cb)
local box=Instance.new("TextBox")
box.Size=UDim2.new(1,0,0,30)
box.PlaceholderText=name
box.BackgroundColor3=Color3.fromRGB(40,40,48)
box.TextColor3=Color3.new(1,1,1)
box.Parent=content
box.FocusLost:Connect(function()
pcall(cb,box.Text)
end)
end

function sec:Paragraph(text)
local p=Instance.new("TextLabel")
p.Size=UDim2.new(1,0,0,40)
p.TextWrapped=true
p.Text=text
p.BackgroundTransparency=1
p.TextColor3=Color3.new(1,1,1)
p.Parent=content
end

return sec
end

return tab
end

return window
end

Library.Loader=Loader
return Library
