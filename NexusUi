    loaderFrame.Parent = GUI
    
    local leftFrame = Instance.new("Frame")
    leftFrame.Name = "LeftFrame"
    leftFrame.Size = UDim2.new(0.5, 0, 1, 0)
    leftFrame.Position = UDim2.new(0, 0, 0, 0)
    leftFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    leftFrame.BorderSizePixel = 0
    leftFrame.Parent = loaderFrame
    
    local rightFrame = Instance.new("Frame")
    rightFrame.Name = "RightFrame"
    rightFrame.Size = UDim2.new(0.5, 0, 1, 0)
    rightFrame.Position = UDim2.new(0.5, 0, 0, 0)
    rightFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    rightFrame.BorderSizePixel = 0
    rightFrame.Parent = loaderFrame
    
    local loadingText = Instance.new("TextLabel")
    loadingText.Name = "LoadingText"
    loadingText.Size = UDim2.new(0.4, 0, 0.1, 0)
    loadingText.Position = UDim2.new(0.3, 0, 0.45, 0)
    loadingText.BackgroundTransparency = 1
    loadingText.Text = "LOADING"
    loadingText.TextColor3 = Color3.fromRGB(255, 255, 255)
    loadingText.TextScaled = true
    loadingText.Font = Enum.Font.GothamBold
    loadingText.Parent = loaderFrame
    
    local loadingBar = Instance.new("Frame")
    loadingBar.Name = "LoadingBar"
    loadingBar.Size = UDim2.new(0, 0, 0.005, 0)
    loadingBar.Position = UDim2.new(0.3, 0, 0.55, 0)
    loadingBar.BackgroundColor3 = Color3.fromRGB(100, 200, 255)
    loadingBar.BorderSizePixel = 0
    loadingBar.Parent = loaderFrame
    
    local barBackground = Instance.new("Frame")
    barBackground.Name = "BarBackground"
    barBackground.Size = UDim2.new(0.4, 0, 0.005, 0)
    barBackground.Position = UDim2.new(0.3, 0, 0.55, 0)
    barBackground.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    barBackground.BorderSizePixel = 0
    barBackground.Parent = loaderFrame
    
    self.Frame = loaderFrame
    self.LeftFrame = leftFrame
    self.RightFrame = rightFrame
    self.TextLabel = loadingText
    self.LoadingBar = loadingBar
    
    CreateTween(loadingBar, TweenInfo.new(2, Enum.EasingStyle.Linear), {Size = UDim2.new(0.4, 0, 0.005, 0)})
    
    return self
end

function Loader:SetText(text)
    if not self.Loading then return end
    self.TextLabel.Text = text
end

function Loader:End()
    if not self.Loading then return end
    
    CreateTween(self.TextLabel, TweenInfo.new(0.5), {TextTransparency = 1})
    CreateTween(self.LoadingBar, TweenInfo.new(0.3), {BackgroundTransparency = 1})
    CreateTween(self.LoadingBar.Parent, TweenInfo.new(0.3), {BackgroundTransparency = 1})
    
    task.wait(0.5)
    
    CreateTween(self.LeftFrame, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(-0.5, 0, 0, 0)})
    CreateTween(self.RightFrame, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(1, 0, 0, 0)})
    
    task.wait(1)
    
    self.Frame:Destroy()
    self.Loading = false
    GUI.Enabled = true
end

