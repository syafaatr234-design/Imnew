local TweenService=game:GetService("TweenService")
local UIS=game:GetService("UserInputService")
local Players=game:GetService("Players")
local player=Players.LocalPlayer
local gui=Instance.new("ScreenGui")
gui.Name="ModernUILibrary"
gui.ResetOnSpawn=false
pcall(function()gui.Parent=game:GetService("CoreGui")end)
if not gui.Parent then gui.Parent=player:WaitForChild("PlayerGui")end

local Library={}
local Loader={}
local Window={}
local Tab={}
local Section={}

local function tween(o,t,p)
TweenService:Create(o,TweenInfo.new(t,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),p):Play()
end

local loaderFrame
local loaderText
local loaderLeft
local loaderRight

function Loader:Start()
loaderFrame=Instance.new("Frame")
loaderFrame.Size=UDim2.fromScale(1,1)
loaderFrame.BackgroundColor3=Color3.fromRGB(15,15,20)
loaderFrame.Parent=gui

loaderLeft=Instance.new("Frame")
loaderLeft.Size=UDim2.fromScale(0.5,1)
loaderLeft.BackgroundColor3=Color3.fromRGB(20,20,28)
loaderLeft.Parent=loaderFrame

loaderRight=Instance.new("Frame")
loaderRight.Size=UDim2.fromScale(0.5,1)
loaderRight.Position=UDim2.fromScale(0.5,0)
loaderRight.BackgroundColor3=Color3.fromRGB(20,20,28)
loaderRight.Parent=loaderFrame

loaderText=Instance.new("TextLabel")
loaderText.AnchorPoint=Vector2.new(.5,.5)
loaderText.Position=UDim2.fromScale(.5,.5)
loaderText.Size=UDim2.fromOffset(400,60)
loaderText.BackgroundTransparency=1
loaderText.TextColor3=Color3.new(1,1,1)
loaderText.Font=Enum.Font.GothamBold
loaderText.TextScaled=true
loaderText.Text="Loading"
loaderText.Parent=loaderFrame
end

function Loader:SetText(t)
if loaderText then
loaderText.Text=t
end
end

function Loader:End()
if not loaderFrame then return end
tween(loaderText,.5,{TextTransparency=1})
tween(loaderLeft,1,{Position=UDim2.fromScale(-.5,0)})
tween(loaderRight,1,{Position=UDim2.fromScale(1,0)})
task.wait(1)
loaderFrame:Destroy()
end

local function drag(frame)
local dragToggle=nil
local dragInput=nil
local dragStart=nil
local startPos=nil
frame.InputBegan:Connect(function(input)
if input.UserInputType==Enum.UserInputType.MouseButton1 then
dragToggle=true
dragStart=input.Position
startPos=frame.Position
input.Changed:Connect(function()
if input.UserInputState==Enum.UserInputState.End then
dragToggle=false
end
end)
end
end)
frame.InputChanged:Connect(function(input)
if input.UserInputType==Enum.UserInputType.MouseMovement then
dragInput=input
end
end)
UIS.InputChanged:Connect(function(input)
if input==dragInput and dragToggle then
local delta=input.Position-dragStart
frame.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
end
end)
end

function Library:Create(cfg)
local main=Instance.new("Frame")
main.Size=UDim2.fromOffset(600,420)
main.Position=UDim2.fromScale(.5,.5)
main.AnchorPoint=Vector2.new(.5,.5)
main.BackgroundColor3=Color3.fromRGB(22,22,28)
main.Parent=gui

drag(main)

local top=Instance.new("Frame")
