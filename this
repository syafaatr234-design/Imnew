local function manualRevive()
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local isDowned = character:GetAttribute("Downed")
    if not isDowned then return end
    
    if getgenv().VoltexUI.FeatureStates.SelfReviveMethod == "Spawnpoint" then
        if not getgenv().VoltexUI.hasRevived then
            getgenv().VoltexUI.hasRevived = true
            pcall(function()
                ReplicatedStorage.Events.Player.ChangePlayerMode:FireServer(true)
            end)
            task.delay(10, function()
                getgenv().VoltexUI.hasRevived = false
            end)
        end
    elseif getgenv().VoltexUI.FeatureStates.SelfReviveMethod == "Fake Revive" then
        if hrp then
            getgenv().VoltexUI.lastSavedPosition = hrp.Position
        end
        task.spawn(function()
            pcall(function()
                ReplicatedStorage.Events.Player.ChangePlayerMode:FireServer(true)
            end)
            
            local newCharacter
            local attempts = 0
            repeat
                newCharacter = LocalPlayer.Character
                task.wait(0.1)
                attempts = attempts + 1
            until (newCharacter and newCharacter:FindFirstChild("HumanoidRootPart") and newCharacter ~= character) or attempts >= 20
            
            if newCharacter then
                local newHRP = newCharacter:FindFirstChild("HumanoidRootPart")
                if getgenv().VoltexUI.lastSavedPosition and newHRP then
                    newHRP.CFrame = CFrame.new(getgenv().VoltexUI.lastSavedPosition)
                end
            end
        end)
    end
end

