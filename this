local function cleanupAllSystems()
    -- Cleanup Anti AFK
    stopAntiAFK()
    
    -- Cleanup ESP
    cleanupESP()
    clearHighlights()
    
    -- Cleanup threads
    if highlightThread then
        coroutine.close(highlightThread)
        highlightThread = nil
    end
    
    for name, thread in pairs(espThreads) do
        if thread then
            coroutine.close(thread)
        end
    end
    
    -- Cleanup connections
    if bhopConnection then bhopConnection:Disconnect() end
    if infiniteSlideHeartbeat then infiniteSlideHeartbeat:Disconnect() end
    if infiniteSlideCharacterConn then infiniteSlideCharacterConn:Disconnect() end
    if respawnConnection then respawnConnection:Disconnect() end
    if AutoSelfReviveConnection then AutoSelfReviveConnection:Disconnect() end
    if InstantReviveConnection then InstantReviveConnection:Disconnect() end
    if AutoCarryConnection then AutoCarryConnection:Disconnect() end
    if AutoTicketFarmConnection then AutoTicketFarmConnection:Disconnect() end
    if FeatureStates.AutoMoneyFarmConnection then FeatureStates.AutoMoneyFarmConnection:Disconnect() end
    if ScreenStretchConn then ScreenStretchConn:Disconnect() end
    if timerDisplayLoop then timerDisplayLoop:Disconnect() end
    
    -- Cleanup Front Jump
    if frontJumpVelocity then
        frontJumpVelocity:Destroy()
        frontJumpVelocity = nil
    end
    
    -- Cleanup feature toggles GUI
    for _, toggle in pairs(featureToggles) do
        if toggle and toggle.Gui then
            pcall(function()
                toggle.Gui:Destroy()
            end)
        end
    end
    
    -- Reset feature states
    FeatureStates.FrontJumpEnabled = false
    FeatureStates.AutoSelfRevive = false
    FeatureStates.InfiniteSlide = false
    FeatureStates.BhopEnabled = false
    FeatureStates.EspPlayer = false
    FeatureStates.EspTicket = false
    FeatureStates.EspNextbot = false
    FeatureStates.HighlightPlayers = false
    FeatureStates.AutoCarry = false
    FeatureStates.AutoTicketFarm = false
    FeatureStates.AutoMoneyFarm = false
    FeatureStates.InstantReviveEnabled = false
    FeatureStates.LagSwitchEnabled = false
    FeatureStates.EmoteEnabled = false
    FeatureStates.AntiAFK = false
end

