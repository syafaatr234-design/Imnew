local function createFeatureToggle(name, initialState, yPosition, toggleCallback)
    local style = ToggleStyles[name] or {}
    local accent = style.Accent or Color3.fromRGB(120, 110, 255)

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = name .. "ToggleGUI"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = PlayerGui

    local main = Instance.new("Frame")
    main.Parent = screenGui
    main.Size = UDim2.fromOffset(190, 62)
    main.Position = UDim2.fromScale(0.5, yPosition)
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    main.BorderSizePixel = 0
    main.Active = true
    main.Draggable = true

    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 14)

    local stroke = Instance.new("UIStroke")
    stroke.Parent = main
    stroke.Thickness = 1.5

    local title = Instance.new("TextLabel")
    title.Parent = main
    title.Size = UDim2.new(1, -12, 0.4, -4)
    title.Position = UDim2.fromOffset(6, 4)
    title.BackgroundTransparency = 1
    title.Text = name:upper()
    title.Font = Enum.Font.GothamSemibold
    title.TextSize = 12
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextColor3 = Color3.fromRGB(200, 200, 220)

    local button = Instance.new("TextButton")
    button.Parent = main
    button.Size = UDim2.new(1, -12, 0.6, -6)
    button.Position = UDim2.new(0, 6, 0.4, 0)
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamBold
    button.TextSize = 13

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 10)

    local function update(state)
        if state then
            button.Text = "ENABLED"
            button.BackgroundColor3 = accent
            button.TextColor3 = Color3.fromRGB(235, 235, 255)
            stroke.Color = accent
        else
            button.Text = "DISABLED"
            button.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
            button.TextColor3 = Color3.fromRGB(170, 170, 190)
            stroke.Color = Color3.fromRGB(70, 70, 90)
        end
    end

    update(initialState)

    button.MouseButton1Click:Connect(function()
        initialState = not initialState
        update(initialState)
        if toggleCallback then
            toggleCallback(initialState)
        end
    end)

    local toggleObj = {
        Gui = screenGui,
        UpdateState = update
    }
    
    getgenv().VoltexUI.Toggles[name] = toggleObj
    getgenv().VoltexUI.ActiveToggles[name] = initialState
    return toggleObj
end

getgenv().VoltexUI.frontJumpVelocity = nil

local function startFrontJump()
    if getgenv().VoltexUI.frontJumpVelocity then 
        pcall(function()
            getgenv().VoltexUI.frontJumpVelocity:Destroy()
        end)
        getgenv().VoltexUI.frontJumpVelocity = nil 
    end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    getgenv().VoltexUI.frontJumpVelocity = Instance.new("BodyVelocity")
    getgenv().VoltexUI.frontJumpVelocity.MaxForce = Vector3.new(400000, 0, 400000)
    getgenv().VoltexUI.frontJumpVelocity.P = 1250
    getgenv().VoltexUI.frontJumpVelocity.Velocity = Vector3.new(0, 0, 0)
    getgenv().VoltexUI.frontJumpVelocity.Parent = root

    local frontJumpConnection
    frontJumpConnection = RunService.Heartbeat:Connect(function()
        if not getgenv().VoltexUI.FeatureStates.FrontJumpEnabled or 
           not getgenv().VoltexUI.frontJumpVelocity or 
           not getgenv().VoltexUI.frontJumpVelocity.Parent then
            if frontJumpConnection then
                frontJumpConnection:Disconnect()
            end
            return
        end
        
        local cam = workspace.CurrentCamera
        if cam and root then
            local forward = cam.CFrame.LookVector
            local direction = Vector3.new(forward.X, 0, forward.Z)
            if direction.Magnitude > 0 then 
                direction = direction.Unit 
            end
            
            local targetVelocity = direction * getgenv().VoltexUI.FeatureStates.FrontJumpSpeed
            getgenv().VoltexUI.frontJumpVelocity.Velocity = targetVelocity
            
            if getgenv().VoltexUI.FeatureStates.FrontAutoJumpEnabled and humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
                local rayOrigin = root.Position
                local rayDir = Vector3.new(0, -4, 0)
                local ray = Ray.new(rayOrigin, rayDir)
                local hit, pos = workspace:FindPartOnRayWithIgnoreList(ray, {char})
                
                if hit then 
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping) 
                end
            end
        end
    end)
    
    getgenv().VoltexUI.Connections["FrontJump"] = frontJumpConnection
end

local function handleFrontJumpToggle(newState)
    getgenv().VoltexUI.FeatureStates.FrontJumpEnabled = newState
    
    if newState then
        startFrontJump()
    else
        if getgenv().VoltexUI.frontJumpVelocity then
            pcall(function()
                getgenv().VoltexUI.frontJumpVelocity:Destroy()
            end)
            getgenv().VoltexUI.frontJumpVelocity = nil
        end
        if getgenv().VoltexUI.Connections["FrontJump"] then
            getgenv().VoltexUI.Connections["FrontJump"]:Disconnect()
            getgenv().VoltexUI.Connections["FrontJump"] = nil
        end
    end
end

