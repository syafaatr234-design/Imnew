-- VARIABEL UNTUK INFINITE SLIDE
local infiniteSlideEnabled = false
local slideFrictionValue = 0
local infiniteSlideCachedTables = nil
local infiniteSlidePlrModel = nil
local infiniteSlideConnection = nil

-- INFINITE SLIDE LOGIC
local infiniteSlideKeys = {
    "Friction","AirStrafeAcceleration","JumpHeight","RunDeaccel",
    "JumpSpeedMultiplier","JumpCap","SprintCap","WalkSpeedMultiplier",
    "BhopEnabled","Speed","AirAcceleration","RunAccel","SprintAcceleration"
}

local function infiniteSlideHasAll(tbl)
    if type(tbl) ~= "table" then return false end
    for _, k in ipairs(infiniteSlideKeys) do 
        if rawget(tbl, k) == nil then return false end 
    end
    return true
end

local function infiniteSlideSetFriction(value)
    if not infiniteSlideCachedTables then return end
    for _, t in ipairs(infiniteSlideCachedTables) do
        pcall(function() 
            if rawget(t, "Friction") ~= nil then
                t.Friction = value 
            end
        end)
    end
end

local function infiniteSlideUpdatePlayerModel()
    local GameFolder = workspace:FindFirstChild("Game")
    local PlayersFolder = GameFolder and GameFolder:FindFirstChild("Players")
    if PlayersFolder then 
        infiniteSlidePlrModel = PlayersFolder:FindFirstChild(LocalPlayer.Name) 
    else 
        infiniteSlidePlrModel = nil 
    end
end

local function infiniteSlideOnHeartbeat()
    if not infiniteSlidePlrModel then 
        infiniteSlideSetFriction(5)
        return 
    end
    
    local success, currentState = pcall(function() 
        return infiniteSlidePlrModel:GetAttribute("State") 
    end)
    
    if success and currentState then
        if currentState == "Slide" then
            pcall(function() 
                infiniteSlidePlrModel:SetAttribute("State", "EmotingSlide") 
            end)
        elseif currentState == "EmotingSlide" then
            infiniteSlideSetFriction(slideFrictionValue)
        else 
            infiniteSlideSetFriction(5) 
        end
    else 
        infiniteSlideSetFriction(5) 
    end
end

local function startInfiniteSlide()
    if infiniteSlideConnection then return end
    
    infiniteSlideCachedTables = {}
    for _, obj in ipairs(getgc(true)) do
        local success, result = pcall(function() 
            if infiniteSlideHasAll(obj) then 
                return obj 
            end 
        end)
        if success and result then 
            table.insert(infiniteSlideCachedTables, result) 
        end
    end
    
    infiniteSlideUpdatePlayerModel()
    
    infiniteSlideConnection = RunService.Heartbeat:Connect(infiniteSlideOnHeartbeat)
    
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.1)
        infiniteSlideUpdatePlayerModel()
    end)
end

local function stopInfiniteSlide()
    if infiniteSlideCachedTables then
        for _, t in ipairs(infiniteSlideCachedTables) do
            pcall(function() 
                if rawget(t, "Friction") ~= nil then
                    t.Friction = 5 
                end
            end)
        end
        infiniteSlideCachedTables = nil
    end
    
    infiniteSlidePlrModel = nil
    
    if infiniteSlideConnection then
        infiniteSlideConnection:Disconnect()
        infiniteSlideConnection = nil
    end
end

