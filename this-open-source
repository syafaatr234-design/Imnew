-- Headless Function untuk LocalPlayer
local function applyHeadless(head)
    if not head then return end

    -- Make head transparent
    head.Transparency = 1
    head.CanCollide = false

    -- Remove face decal if exists
    local face = head:FindFirstChild("face")
    if face then
        face:Destroy()
    end

    -- Add tiny invisible mesh to prevent head from reappearing
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Head
    mesh.Scale = Vector3.new(0.001, 0.001, 0.001)
    mesh.Parent = head

    -- Ensure head stays transparent
    local connection
    connection = head:GetPropertyChangedSignal("Transparency"):Connect(function()
        if head.Transparency ~= 1 then
            head.Transparency = 1
        end
    end)

    -- Remove face if added later
    head.ChildAdded:Connect(function(child)
        if child.Name == "face" and child:IsA("Decal") then
            child:Destroy()
        end
    end)

    return connection
end

-- Korblox Function untuk LocalPlayer
local function applyKorblox(character)
    -- Find right leg (for R6 or R15)
    local rightLeg = character:FindFirstChild("Right Leg")
    if not rightLeg then
        rightLeg = character:FindFirstChild("RightUpperLeg")
    end
    
    if not rightLeg then
        warn("Right leg not found for Korblox!")
        return
    end

    -- Set leg color to dark grey/black for Korblox effect
    rightLeg.Color = Color3.fromRGB(30, 30, 30)
    
    -- Ensure color stays dark
    local connection
    connection = rightLeg:GetPropertyChangedSignal("Color"):Connect(function()
        if rightLeg.Color ~= Color3.fromRGB(30, 30, 30) then
            rightLeg.Color = Color3.fromRGB(30, 30, 30)
        end
    end)

    return connection
end

-- Function to apply visual effects to character (LocalPlayer only)
local function applyVisualEffects(character)
    local head = character:FindFirstChild("Head")
    
    -- Apply headless if enabled (LocalPlayer only)
    if featureStates.HeadlessEnabled and head then
        if featureStates.headlessConnection then
            featureStates.headlessConnection:Disconnect()
        end
        featureStates.headlessConnection = applyHeadless(head)
    elseif head then
        -- Restore head if disabled
        head.Transparency = 0
        local mesh = head:FindFirstChildWhichIsA("SpecialMesh")
        if mesh and mesh.Scale == Vector3.new(0.001, 0.001, 0.001) then
            mesh:Destroy()
        end
    end
    
    -- Apply Korblox if enabled (LocalPlayer only)
    if featureStates.KorbloxEnabled then
        if featureStates.korbloxConnection then
            featureStates.korbloxConnection:Disconnect()
        end
        featureStates.korbloxConnection = applyKorblox(character)
    else
        -- Restore leg color if disabled
        local rightLeg = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg")
        if rightLeg then
            rightLeg.Color = Color3.fromRGB(163, 162, 165) -- Default Roblox color
        end
    end
end

