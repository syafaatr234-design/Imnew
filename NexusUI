    -- Edit Open Window function
    function window:EditOpenWindow(newOptions)
        newOptions = newOptions or {}
        
        if newOptions.Title then
            title.Text = newOptions.Title
        end
        
        if newOptions.Size then
            originalSize = UDim2.new(0, newOptions.Size.X or 700, 0, newOptions.Size.Y or 450)
            if not minimized then
                TweenService:Create(mainFrame, TweenInfo.new(0.3), {
                    Size = originalSize
                }):Play()
            end
        end
        
        if newOptions.Position then
            local newPos = UDim2.new(0, newOptions.Position.X or 0, 0, newOptions.Position.Y or 0)
            if not minimized then
                TweenService:Create(mainFrame, TweenInfo.new(0.3), {
                    Position = newPos
                }):Play()
            end
        end
        
        if newOptions.Color then
            -- Update gradient colors
            gradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, newOptions.Color),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
            })
        end
        
        if newOptions.Shape then
            if newOptions.Shape == "Square" then
                corner.CornerRadius = UDim.new(0, 0)
                titleBarCorner.CornerRadius = UDim.new(0, 0)
            elseif newOptions.Shape == "Rounded" then
                corner.CornerRadius = UDim.new(0, 12)
                titleBarCorner.CornerRadius = UDim.new(0, 12)
            elseif newOptions.Shape == "Circle" then
                corner.CornerRadius = UDim.new(1, 0)
                titleBarCorner.CornerRadius = UDim.new(1, 0)
            end
        end
    end
    
